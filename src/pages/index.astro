---
import BaseLayout from "../layouts/BaseLayout.astro";
import { SITE, mailto, personJsonLd } from "../data/site";
import selectedWork from "../data/selected-work.json";
import { resume } from "../data/resume";
import { formatMonth } from "../utils/dates";

const description = SITE.homeDescription;
const jsonLd = personJsonLd(description);

const experience = resume.experience.flatMap((employer) =>
  employer.roles.map((role) => ({
    company: employer.company,
    role: role.title,
    start: role.start ?? employer.start,
    end: role.end ?? employer.end,
    note: role.homeSummary,
  }))
);
---

<BaseLayout title={SITE.homeTitle} description={description} jsonLd={jsonLd}>
  <section class="hero" aria-labelledby="intro-heading">
    <div class="container">
      <div class="hero-main">
        <p class="eyebrow">
          <span class="status-dot" aria-hidden="true"></span>
          Pittsburgh, PA · Remote
        </p>
        <h1 id="intro-heading">Adam Miller<span class="accent" aria-hidden="true">.</span></h1>
        <p class="hero-title">{SITE.headline}</p>
        <p class="hero-intro">{SITE.intro}</p>
        <div class="hero-actions">
          <a class="button button--primary" href="/resume">
            View resume <span aria-hidden="true">→</span>
          </a>
          <a class="button button--ghost" href={mailto}>Email</a>
          <a
            class="text-link"
            href={SITE.linkedin}
            rel="me"
          >LinkedIn <span aria-hidden="true">↗</span></a>
        </div>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="work-heading">
    <div class="container">
      <div class="section-head">
        <h2 class="section-title" id="work-heading">Selected work</h2>
      </div>
      <ul class="work-grid">
        {selectedWork.map((item) => (
          <li class="work-card">
            <h3 class="work-title">{item.title}</h3>
            <p class="work-tag">{item.tag}</p>
            <p class="work-body">{item.body}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section" aria-labelledby="experience-heading">
    <div class="container">
      <div class="section-head">
        <h2 class="section-title" id="experience-heading">Selected experience</h2>
        <a class="text-link" href="/resume">Full resume <span aria-hidden="true">→</span></a>
      </div>
      <ul class="index-list">
        {experience.map((item) => (
          <li class="index-item">
            <span class="index-company">{item.company}</span>
            <span class="index-role">{item.role}</span>
            <span class="index-date">
              <time datetime={item.start}>{formatMonth(item.start, "short")}</time> – <time datetime={item.end}>{formatMonth(item.end, "short")}</time>
            </span>
            <p class="index-note">{item.note}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="contact-band" aria-labelledby="contact-heading">
    <div class="container contact-inner">
      <div>
        <h2 id="contact-heading">Get in touch</h2>
        <p class="contact-copy">{SITE.closer}</p>
      </div>
      <div class="contact-links">
        <a class="button button--primary" href={mailto}>
          Email <span class="visually-hidden">Adam Miller</span>
        </a>
        <a class="button button--ghost" href={SITE.linkedin} rel="me">
          LinkedIn <span aria-hidden="true">↗</span>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
