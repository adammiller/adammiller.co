---
import BaseLayout from "../layouts/BaseLayout.astro";
import { SITE, mailto, personJsonLd } from "../data/site";
import selectedWork from "../data/selected-work.json";
import { resume } from "../data/resume";
import { formatMonth } from "../utils/dates";

const description = SITE.homeDescription;
const jsonLd = personJsonLd(description);
---

<BaseLayout title={SITE.homeTitle} description={description} jsonLd={jsonLd}>
  <section class="hero" aria-labelledby="intro-heading">
    <div class="container">
      <div class="hero-inner">
        <p class="eyebrow">
          <span class="status-dot" aria-hidden="true"></span>
          {SITE.locationLine}
        </p>
        <h1 id="intro-heading">
          Adam <span class="scribble">Miller<svg
              viewBox="0 0 300 12"
              preserveAspectRatio="none"
              aria-hidden="true"
            >
              <path d="M2 7 C 50 3, 110 9, 170 6 S 260 3, 298 6" stroke-width="2.6"></path>
              <path d="M6 9 C 70 6, 140 10, 200 8 S 270 6, 294 8" stroke-width="1.2" opacity=".55"></path>
            </svg></span>
        </h1>
        <p class="hero-headline">{SITE.headline}</p>
        <p class="lede">{SITE.intro}</p>
        <div class="hero-actions">
          <a class="button button--primary" href="#work">See selected work</a>
          <a class="button button--secondary" href={mailto}>Get in touch</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section" id="work" aria-labelledby="work-heading">
    <div class="container">
      <div class="section-head">
        <div class="section-title">
          <svg class="marker" viewBox="0 0 8 32" preserveAspectRatio="none" aria-hidden="true">
            <path d="M4 1.5 C 2.6 8, 5 13, 3.4 19 S 4.6 27, 3.8 30.5"></path>
          </svg>
          <h2 id="work-heading">Selected work</h2>
        </div>
      </div>
      <ul class="work-grid">
        {selectedWork.map((item) => (
          <li>
            <article class="card work-card">
              <div class="work-card-head">
                <h3>{item.title}</h3>
                <span class="chip chip--green">
                  <span class="chip__dot" aria-hidden="true"></span>
                  {item.tag}
                </span>
              </div>
              <p>{item.body}</p>
            </article>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section" aria-labelledby="experience-heading">
    <div class="container">
      <div class="section-head">
        <h2 id="experience-heading">Selected experience</h2>
        <a class="text-link" href="/resume">Full resume <span aria-hidden="true">→</span></a>
      </div>
      <ul class="experience-list">
        {resume.experience.map((employer) => (
          <li class="experience-employer">
            <div class="experience-head">
              <h3>{employer.company}</h3>
              <p class="date-range">
                <time datetime={employer.start}>{formatMonth(employer.start, "short")}</time> – <time datetime={employer.end}>{formatMonth(employer.end, "short")}</time>
              </p>
            </div>
            <ul class="role-list">
              {employer.roles.map((role) => (
                <li>
                  <div class="role-head">
                    <h4>{role.title}</h4>
                    {role.start && role.end && (
                      <p class="date-range">
                        <time datetime={role.start}>{formatMonth(role.start, "short")}</time> – <time datetime={role.end}>{formatMonth(role.end, "short")}</time>
                      </p>
                    )}
                  </div>
                  <p class="role-note">{role.homeSummary}</p>
                </li>
              ))}
            </ul>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section" aria-labelledby="contact-heading">
    <div class="container">
      <div class="card contact-card">
        <div class="contact-copy">
          <p class="eyebrow">Contact</p>
          <h2 id="contact-heading">Get in touch</h2>
          <p class="lede">{SITE.closer}</p>
        </div>
        <div class="contact-actions">
          <a class="button button--primary" href={mailto}>{SITE.email}</a>
          <a class="button button--secondary" href={SITE.linkedin} rel="me">
            LinkedIn <span aria-hidden="true">↗</span>
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
