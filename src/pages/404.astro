---
import BaseLayout from "../layouts/BaseLayout.astro";

const title = "Page not found — Adam Miller";
const description = "The page you were looking for does not exist or has moved.";
---

<BaseLayout title={title} description={description}>
  <section class="hero error-page" aria-labelledby="not-found-heading">
    <div class="container">
      <p class="eyebrow">
        <span class="status-dot" aria-hidden="true"></span>
        404
      </p>
      <h1 id="not-found-heading">Page not found<span class="accent" aria-hidden="true">.</span></h1>
      <p class="hero-intro">
        The page you were looking for doesn't exist or has moved.
      </p>
      <div class="hero-actions">
        <a class="button button--primary" href="/">Back home <span aria-hidden="true">→</span></a>
        <a class="button button--ghost" href="/resume">View resume</a>
      </div>
    </div>
  </section>
</BaseLayout>
