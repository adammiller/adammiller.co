---
import BaseLayout from "../layouts/BaseLayout.astro";

const title = "Page not found — Adam Miller";
const description = "The page you were looking for does not exist or has moved.";
---

<BaseLayout title={title} description={description}>
  <section class="hero error-page" aria-labelledby="not-found-heading">
    <div class="container">
      <div class="hero-inner">
        <p class="eyebrow">
          <span class="status-dot" aria-hidden="true"></span>
          404
        </p>
        <h1 id="not-found-heading">Page not found</h1>
        <p class="lede">
          The page you were looking for doesn't exist or has moved.
        </p>
        <div class="hero-actions">
          <a class="button button--primary" href="/">Back home <span aria-hidden="true">→</span></a>
          <a class="button button--secondary" href="/resume">View resume</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
