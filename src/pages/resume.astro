---
import BaseLayout from "../layouts/BaseLayout.astro";
import { SITE, mailto, personJsonLd } from "../data/site";
import { resume } from "../data/resume";
import { formatMonth } from "../utils/dates";

const description = SITE.resumeDescription;
const jsonLd = personJsonLd(description);

const { summary, experience, earlier, earlierRange, skills, education } = resume;
---

<BaseLayout title={SITE.resumeTitle} description={description} jsonLd={jsonLd}>
  <div class="resume-page">
    <div class="container">
      <div class="resume-toolbar">
        <a class="button button--ghost button--small" href="/adam-miller-resume.pdf" download>
          Download PDF <span aria-hidden="true">↓</span>
        </a>
      </div>

      <article class="resume">
        <header class="resume-header">
          <h1>Adam Miller</h1>
          <p class="resume-role">{SITE.headline}</p>
          <p class="resume-contact">
            <span>{SITE.location} (remote)</span>
            <span aria-hidden="true">·</span>
            <a href={mailto}>Email</a>
            <span aria-hidden="true">·</span>
            <a href={SITE.linkedin} rel="me">LinkedIn</a>
          </p>
        </header>

        <section class="resume-section" aria-labelledby="summary-heading">
          <h2 id="summary-heading">Professional Summary</h2>
          <p>{summary}</p>
        </section>

        <section class="resume-section" aria-labelledby="experience-heading">
          <h2 id="experience-heading">Professional Experience</h2>

          {experience.map((employer) => (
            <div class="employer">
              <header class="employer-head">
                <h3>{employer.company}</h3>
                <p class="date-range">
                  <time datetime={employer.start}>{formatMonth(employer.start)}</time> – <time datetime={employer.end}>{formatMonth(employer.end)}</time>
                </p>
              </header>

              {employer.roles.map((role) => (
                <article class="role">
                  <header class="role-head">
                    <h4>{role.title}</h4>
                    {role.start && role.end && (
                      <p class="date-range">
                        <time datetime={role.start}>{formatMonth(role.start)}</time> – <time datetime={role.end}>{formatMonth(role.end)}</time>
                      </p>
                    )}
                  </header>
                  {role.intro && <p class="role-intro">{role.intro}</p>}
                  <ul>
                    {role.bullets.map((bullet) => <li>{bullet}</li>)}
                  </ul>
                </article>
              ))}
            </div>
          ))}
        </section>

        <section class="resume-section" aria-labelledby="earlier-heading">
          <div class="resume-section-head">
            <h2 id="earlier-heading">Earlier Experience</h2>
            <p class="date-range">
              <time datetime={earlierRange.start}>{earlierRange.start}</time> – <time datetime={earlierRange.end}>{earlierRange.end}</time>
            </p>
          </div>

          {earlier.map((item) => (
            <article class="earlier-role">
              <h3>
                {item.title} <span class="date-range">(<time datetime={item.start}>{item.start}</time>–<time datetime={item.end}>{item.end}</time>)</span>
              </h3>
              <p>{item.description}</p>
            </article>
          ))}
        </section>

        <section class="resume-section" aria-labelledby="skills-heading">
          <h2 id="skills-heading">Skills</h2>
          <dl class="skills">
            {skills.map((group) => (
              <div>
                <dt>{group.label}</dt>
                <dd>{group.items}</dd>
              </div>
            ))}
          </dl>
        </section>

        <section class="resume-section education" aria-labelledby="education-heading">
          <h2 id="education-heading">Education</h2>
          <article>
            <h3>{education.degree}</h3>
            <p>{education.school}</p>
          </article>
        </section>
      </article>
    </div>
  </div>
</BaseLayout>
