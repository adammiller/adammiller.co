---
import BaseLayout from "../layouts/BaseLayout.astro";

const title = "Resume — Adam Miller, Senior Staff Software Engineer";
const description =
  "Resume for Adam Miller, Senior Staff Software Engineer: nearly 20 years building frontend platforms, developer tooling and AI-native developer experiences, most recently at Netflix.";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Adam Miller",
  jobTitle: "Senior Staff Software Engineer",
  url: "https://adammiller.co/",
  address: {
    "@type": "PostalAddress",
    addressLocality: "Pittsburgh",
    addressRegion: "PA",
    addressCountry: "US",
  },
  sameAs: ["https://www.linkedin.com/in/adammillerrr"],
};
---

<BaseLayout title={title} description={description} jsonLd={jsonLd}>
  <div class="resume-page">
    <div class="container">
      <div class="resume-toolbar">
        <a class="button button--ghost button--small" href="/adam-miller-resume.pdf" download>
          Download PDF <span aria-hidden="true">↓</span>
        </a>
      </div>

      <article class="resume">
        <header class="resume-header">
          <h1>Adam Miller</h1>
          <p class="resume-role">
            Senior Staff Software Engineer · Frontend Platform, UI Quality &amp;
            AI-Native UX
          </p>
          <p class="resume-contact">
            <span>Pittsburgh, PA (remote)</span>
            <span aria-hidden="true">·</span>
            <a href="mailto:acm6603@gmail.com">Email</a>
            <span aria-hidden="true">·</span>
            <a href="https://www.linkedin.com/in/adammillerrr" rel="me">LinkedIn</a>
            <span aria-hidden="true">·</span>
            <a href="/">adammiller.co</a>
          </p>
        </header>

        <section class="resume-section" aria-labelledby="summary-heading">
          <h2 id="summary-heading">Professional Summary</h2>
          <p>
            Frontend and platform engineer with nearly 20 years of building the
            foundations that large engineering orgs ship user-facing products on. At
            Netflix I worked across the JS Platform org (1,000+ engineers, 900+
            applications): I built the codemod tooling that migrates the entire
            application fleet across breaking changes, co-maintained the Hawkins
            design system, and set long-term direction for our app platform through
            Jetpack Northstar, aligning three platform teams and their partners.
            Before that I was principal engineer and technical lead for a 50-engineer
            org at Walmart, where I designed SamsClub.com's server-rendered React
            architecture and raised test coverage from ~13% to 92%. Most recently I
            led the platform's shift to agentic development and created a Generative
            UI Working Group exploring agent-driven interfaces.
          </p>
        </section>

        <section class="resume-section" aria-labelledby="experience-heading">
          <h2 id="experience-heading">Professional Experience</h2>

          <div class="employer">
            <header class="employer-head">
              <h3>Netflix</h3>
              <p class="date-range">
                <time datetime="2021-07">July 2021</time> – <time datetime="2026-10">October 2026</time>
              </p>
            </header>

            <article class="role" aria-labelledby="netflix-em-heading">
              <header class="role-head">
                <h4 id="netflix-em-heading">Engineering Manager, JS Platform</h4>
                <p class="date-range">
                  <time datetime="2026-02">February 2026</time> – <time datetime="2026-10">October 2026</time>
                </p>
              </header>
              <ul>
                <li>
                  Managed two teams in succession within the JS Platform org (1,000+
                  engineers, 900+ applications, ~40,000 PRs merged per week across the
                  fleet): UI Developer Experience (6 engineers, Feb-Aug), then
                  JavaScript Application Platform (5 engineers, Aug-Oct), owner of
                  Jetpack, Netflix's managed platform for developing and deploying
                  JavaScript applications.
                </li>
                <li>
                  Set long-term direction with the Jetpack Northstar foundation
                  (guiding principles, strategy bets), aligning three platform teams
                  and partners in Delivery, Source Control and Tech Catalog.
                </li>
                <li>
                  Created and led the Generative UI Working Group (50+ attendees per
                  meeting across engineering, design and product), evaluating MCP
                  Apps, WebMCP and CopilotKit for agent-driven internal and
                  operational UIs.
                </li>
                <li>
                  Led the platform's shift to agentic development, with tooling
                  available to all 1,000+ engineers:
                  <ul>
                    <li>
                      Headless remote dev servers that run in parallel so multiple
                      agents can work in separate git worktrees.
                    </li>
                    <li>
                      Every platform CLI refactored so embedded prompts became flags
                      with help text, letting agents use them without guidance.
                    </li>
                    <li>
                      llm-context embedded in 100% of platform-provided libraries,
                      kept current by an agent triggered from CI as the underlying
                      libraries change.
                    </li>
                    <li>
                      Equipped Netflix's sandboxed agentic runtime with this tooling,
                      enabling it to deliver verified code changes to JavaScript
                      applications.
                    </li>
                  </ul>
                </li>
                <li>
                  Grew engineers (an intern converted to full-time who was soon
                  building GraphQL migration tooling across ~150 repos; two engineers
                  prepared for promotion), led a team through a reorg, and mentored
                  two engineering teams in Warsaw.
                </li>
              </ul>
            </article>

            <article class="role" aria-labelledby="netflix-senior-heading">
              <header class="role-head">
                <h4 id="netflix-senior-heading">Senior Software Engineer, JS Platform</h4>
                <p class="date-range">
                  <time datetime="2023-05">May 2023</time> – <time datetime="2026-01">January 2026</time>
                </p>
              </header>
              <ul>
                <li>
                  Built an automated dependency-upgrade CLI with codemods that
                  migrated the JS application fleet across breaking changes in design
                  system and browser runtime libraries, cutting down the time
                  required for large applications to migrate from weeks to days and
                  saving thousands of engineering hours.
                </li>
                <li>
                  Core maintainer of Hawkins Professional, Netflix's internal design
                  system.
                </li>
                <li>
                  Created and led a monthly customer program with product engineering
                  teams, turning their feedback into platform roadmap features and
                  earning the highest customer satisfaction scores of any platform
                  team at Netflix.
                </li>
                <li>
                  Designed and shipped Netflix's paved-path tooling for JavaScript
                  library versioning and publishing, closing a years-long gap in the
                  platform's offerings.
                </li>
                <li>
                  Built GraphQL introspection and codegen tooling that standardized
                  data fetching for JS clients, with end-to-end type-safe requests
                  across Netflix's federated graph, one of the industry's largest.
                </li>
                <li>
                  Shared on-call for Jetpack and NodeQuark, responding to production
                  incidents on the platforms that build, deploy and run Netflix's
                  JavaScript applications.
                </li>
              </ul>
            </article>

            <article class="role" aria-labelledby="netflix-studio-heading">
              <header class="role-head">
                <h4 id="netflix-studio-heading">Senior Software Engineer, Studio Foundations</h4>
                <p class="date-range">
                  <time datetime="2021-07">July 2021</time> – <time datetime="2023-04">April 2023</time>
                </p>
              </header>
              <ul>
                <li>
                  Built Data Mechanic, Studio's data-quality hub: replaced a
                  spreadsheet-based process that had Data Admins jumping between
                  three apps with one deduplication workflow powered by algorithmic
                  matching and a graph database.
                </li>
                <li>
                  Designed and built its core interface, a novel UI that lays graph
                  relationships out in a 2D table with rich side-by-side record
                  comparison, so Data Admins could see how possible duplicates
                  connect and act on them in one place.
                </li>
                <li>
                  Overhauled how Studio Data Admins worked, making them an order of
                  magnitude more productive as measured by possible duplicate records
                  resolved across Netflix's talent, vendor and production data.
                </li>
                <li>
                  Partnered with Data Admins, design and product to shape the
                  workflow, plus embeddable data-entry and validation components used
                  across Studio production tools.
                </li>
              </ul>
            </article>
          </div>

          <div class="employer">
            <header class="employer-head">
              <h3>Walmart eCommerce</h3>
              <p class="date-range">
                <time datetime="2016-02">February 2016</time> – <time datetime="2021-07">July 2021</time>
              </p>
            </header>

            <article class="role" aria-labelledby="walmart-heading">
              <header class="role-head">
                <h4 id="walmart-heading">Principal Software Engineer, SamsClub.com</h4>
              </header>
              <ul>
                <li>
                  Designed the UI architecture for SamsClub.com's server-rendered
                  React app, which drives millions of dollars in daily revenue.
                </li>
                <li>
                  Drove test coverage across the SamsClub.com React codebase from
                  ~13% to 92%: added coverage reporting and thresholds to every repo
                  and established a team-wide practice of requiring tests for new
                  functionality, which other engineers extended by retrofitting unit
                  tests for key existing code.
                </li>
                <li>
                  Technical lead for a 50-engineer org, owning code quality,
                  documentation and developer productivity.
                </li>
                <li>
                  Ensured SamsClub.com's session replay and logging tools did not
                  capture customers' personal data.
                </li>
              </ul>
            </article>
          </div>
        </section>

        <section class="resume-section" aria-labelledby="earlier-heading">
          <div class="resume-section-head">
            <h2 id="earlier-heading">Earlier Experience</h2>
            <p class="date-range">
              <time datetime="2007">2007</time> – <time datetime="2016">2016</time>
            </p>
          </div>

          <article class="earlier-role">
            <h3>
              Saturday Morning Projects, Founder <span class="date-range">(<time datetime="2009">2009</time>–<time datetime="2016">2016</time>)</span>
            </h3>
            <p>
              Consulting, full-stack builds and deployment for startups, nonprofits
              and agencies, alongside the roles around it.
            </p>
          </article>

          <article class="earlier-role">
            <h3>
              The Barbarian Group, Senior Design Technologist and Developer <span class="date-range">(<time datetime="2007">2007</time>–<time datetime="2013">2013</time>)</span>
            </h3>
            <p>Led builds for GE, Mozilla and Red Bull.</p>
          </article>

          <article class="earlier-role">
            <h3>
              Wikimedia Foundation, UI Software Engineer <span class="date-range">(<time datetime="2009">2009</time>–<time datetime="2010">2010</time>)</span>
            </h3>
            <p>Usability Initiative features still live on Wikipedia.</p>
          </article>
        </section>

        <section class="resume-section" aria-labelledby="skills-heading">
          <h2 id="skills-heading">Skills</h2>
          <dl class="skills">
            <div>
              <dt>Stack</dt>
              <dd>TypeScript, React, Node.js</dd>
            </div>
            <div>
              <dt>Platform</dt>
              <dd>
                web performance, React SSR, Turborepo, CI/CD (Jenkins, GitHub
                Actions, Spinnaker), dependency management, CLI/TUI tooling,
                codemods (TS, CSS, GraphQL), design systems, GraphQL federation,
                on-call and incident response
              </dd>
            </div>
            <div>
              <dt>Backend &amp; data</dt>
              <dd>
                Postgres, Elasticsearch, graph databases, KVDAL (Netflix's key-value
                data abstraction), GraphQL API design
              </dd>
            </div>
            <div>
              <dt>AI tooling</dt>
              <dd>MCP, agent-native developer workflows, agent plugins</dd>
            </div>
            <div>
              <dt>Leadership</dt>
              <dd>
                technical strategy, cross-functional alignment, customer programs,
                mentoring, hiring
              </dd>
            </div>
          </dl>
        </section>

        <section class="resume-section education" aria-labelledby="education-heading">
          <h2 id="education-heading">Education</h2>
          <article>
            <h3>Bachelor of Science, New Media</h3>
            <p>Rochester Institute of Technology</p>
          </article>
        </section>
      </article>
    </div>
  </div>
</BaseLayout>
