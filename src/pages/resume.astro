---
import BaseLayout from "../layouts/BaseLayout.astro";

const title = "Resume — Adam Miller, Staff Software Engineer";
const description =
  "Resume for Adam Miller, Staff Software Engineer: nearly 20 years building web products and the platforms other teams use to ship them, most recently at Netflix.";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Adam Miller",
  jobTitle: "Staff Software Engineer",
  url: "https://adammiller.co/",
  address: {
    "@type": "PostalAddress",
    addressLocality: "Pittsburgh",
    addressRegion: "PA",
    addressCountry: "US",
  },
  sameAs: ["https://www.linkedin.com/in/adammillerrr"],
};
---

<BaseLayout title={title} description={description} jsonLd={jsonLd}>
  <div class="resume-page">
    <div class="container">
      <div class="resume-toolbar">
        <a class="button button--ghost button--small" href="/adam-miller-resume.pdf" download>
          Download PDF <span aria-hidden="true">↓</span>
        </a>
      </div>

      <article class="resume">
        <header class="resume-header">
          <h1>Adam Miller</h1>
          <p class="resume-role">
            Staff Software Engineer, Product &amp; Growth Engineering
          </p>
          <p class="resume-contact">
            <span>Pittsburgh, PA (remote)</span>
            <span aria-hidden="true">·</span>
            <a href="mailto:acm6603@gmail.com">Email</a>
            <span aria-hidden="true">·</span>
            <a href="https://www.linkedin.com/in/adammillerrr" rel="me">LinkedIn</a>
            <span aria-hidden="true">·</span>
            <a href="/">adammiller.co</a>
          </p>
        </header>

        <section class="resume-section" aria-labelledby="summary-heading">
          <h2 id="summary-heading">Professional Summary</h2>
          <p>
            Product-minded full-stack engineer with nearly 20 years of building web
            products and the platforms that other teams use to ship them. At Walmart
            I was principal engineer and technical lead for a 50-engineer org, where I
            designed the server-rendered React architecture behind SamsClub.com,
            which drives millions of dollars in daily revenue. At Netflix I built a
            greenfield data-quality product that made Data Admins an order of
            magnitude more efficient, ran a customer program that earned the highest
            satisfaction scores of any Netflix platform team, and built tooling every
            JavaScript team at Netflix relies on. Most recently I led teams in the JS
            Platform org, serving 1,000+ engineers, and drove the org's shift to
            agentic development. I like ambiguous problems with a clear business
            number at the end of them.
          </p>
        </section>

        <section class="resume-section" aria-labelledby="experience-heading">
          <h2 id="experience-heading">Professional Experience</h2>

          <div class="employer">
            <header class="employer-head">
              <h3>Netflix</h3>
              <p class="date-range">
                <time datetime="2021-07">July 2021</time> – <time datetime="2026-10">October 2026</time>
              </p>
            </header>

            <article class="role" aria-labelledby="netflix-em-heading">
              <header class="role-head">
                <h4 id="netflix-em-heading">Engineering Manager, JS Platform</h4>
                <p class="date-range">
                  <time datetime="2026-02">February 2026</time> – <time datetime="2026-10">October 2026</time>
                </p>
              </header>
              <ul>
                <li>
                  Managed two teams in succession (6, then 5 engineers) in the JS
                  Platform org serving 1,000+ engineers, 900+ applications, and
                  supporting ~40,000 merged PRs per week.
                </li>
                <li>
                  Set long-term direction with the Jetpack Northstar foundation
                  (guiding principles, strategy bets), aligning three platform teams
                  and partners in Delivery, Source Control and Tech Catalog.
                </li>
                <li>
                  Led the platform's shift to agentic development, shipping tooling
                  to all 1,000+ engineers: parallel headless remote dev servers for
                  agents working in separate git worktrees, agent-friendly CLIs, and
                  llm-context in 100% of platform libraries, kept current by a
                  CI-triggered agent.
                </li>
                <li>
                  Created and led the Generative UI Working Group, evaluating MCP
                  Apps, WebMCP and CopilotKit for agent-driven interfaces.
                </li>
                <li>
                  Grew engineers, including converting an intern to full-time and
                  preparing two engineers for promotion. Led teams through a reorg
                  with no disruption to in-flight projects or career growth goals.
                </li>
              </ul>
            </article>

            <article class="role" aria-labelledby="netflix-senior-heading">
              <header class="role-head">
                <h4 id="netflix-senior-heading">Senior Software Engineer, JS Platform</h4>
                <p class="date-range">
                  <time datetime="2023-05">May 2023</time> – <time datetime="2026-01">January 2026</time>
                </p>
              </header>
              <ul>
                <li>
                  Created and led a monthly customer program with product engineering
                  teams, turning their feedback into roadmap features and earning the
                  highest customer satisfaction scores of any platform team at
                  Netflix.
                </li>
                <li>
                  Built an automated dependency-upgrade CLI with codemods that
                  migrated the JS application fleet across breaking changes in design
                  system and browser runtime libraries, cutting large-app migrations
                  from weeks to days and saving thousands of engineering hours.
                </li>
                <li>
                  Designed and shipped Netflix's paved path for JavaScript library
                  versioning and publishing from scratch, closing a years-long gap in
                  the platform.
                </li>
                <li>
                  Built GraphQL introspection and codegen tooling with end-to-end
                  type-safe requests across Netflix's federated graph, standardizing
                  data fetching for JS clients.
                </li>
                <li>
                  Core maintainer of Hawkins Professional, Netflix's internal design
                  system.
                </li>
              </ul>
            </article>

            <article class="role" aria-labelledby="netflix-studio-heading">
              <header class="role-head">
                <h4 id="netflix-studio-heading">Senior Software Engineer, Studio Foundations</h4>
                <p class="date-range">
                  <time datetime="2021-07">July 2021</time> – <time datetime="2023-04">April 2023</time>
                </p>
              </header>
              <ul>
                <li>
                  Built Data Mechanic, a greenfield data-quality product that
                  replaced a spreadsheet process spread across three apps with one
                  guided deduplication workflow, making Data Admins an order of
                  magnitude more efficient across Netflix's talent, vendor and
                  production data.
                </li>
                <li>
                  Designed a novel interface that shows how similar records connect
                  in a graph database, so users could see why records matched and
                  resolve duplicates in one place.
                </li>
                <li>
                  Built embeddable data-entry and validation components used across
                  Studio production tools.
                </li>
              </ul>
            </article>
          </div>

          <div class="employer">
            <header class="employer-head">
              <h3>Walmart eCommerce</h3>
              <p class="date-range">
                <time datetime="2016-02">February 2016</time> – <time datetime="2021-07">July 2021</time>
              </p>
            </header>

            <article class="role" aria-labelledby="walmart-heading">
              <header class="role-head">
                <h4 id="walmart-heading">Principal Software Engineer, SamsClub.com</h4>
              </header>
              <ul>
                <li>
                  Designed the UI architecture for SamsClub.com's server-rendered
                  React app, which drives millions of dollars in daily revenue.
                </li>
                <li>
                  Revamped cart, search, product details, and add-to-cart buttons,
                  validating each change with A/B tests and gradual rollouts, lifting
                  conversion 1–3% per change.
                </li>
                <li>
                  Technical lead for a 50-engineer org, owning code quality,
                  documentation and developer productivity.
                </li>
                <li>
                  Drove test coverage across the SamsClub.com React codebase from
                  ~13% to 92% with coverage thresholds in every repo and a team-wide
                  practice of testing new functionality.
                </li>
              </ul>
            </article>
          </div>
        </section>

        <section class="resume-section" aria-labelledby="earlier-heading">
          <div class="resume-section-head">
            <h2 id="earlier-heading">Earlier Experience</h2>
            <p class="date-range">
              <time datetime="2007">2007</time> – <time datetime="2016">2016</time>
            </p>
          </div>

          <article class="earlier-role">
            <h3>
              Saturday Morning Projects, Founder <span class="date-range">(<time datetime="2009">2009</time>–<time datetime="2016">2016</time>)</span>
            </h3>
            <p>
              Consulting, full-stack product builds and launches for startups,
              nonprofits and agencies.
            </p>
          </article>

          <article class="earlier-role">
            <h3>
              The Barbarian Group, Senior Design Technologist and Developer <span class="date-range">(<time datetime="2007">2007</time>–<time datetime="2013">2013</time>)</span>
            </h3>
            <p>Led builds for GE, Mozilla and Red Bull.</p>
          </article>

          <article class="earlier-role">
            <h3>
              Wikimedia Foundation, UI Software Engineer <span class="date-range">(<time datetime="2009">2009</time>–<time datetime="2010">2010</time>)</span>
            </h3>
            <p>Usability Initiative features still live on Wikipedia.</p>
          </article>
        </section>

        <section class="resume-section" aria-labelledby="skills-heading">
          <h2 id="skills-heading">Skills</h2>
          <dl class="skills">
            <div>
              <dt>Stack</dt>
              <dd>TypeScript, React (SSR), Node.js, GraphQL</dd>
            </div>
            <div>
              <dt>Product</dt>
              <dd>
                customer research and feedback programs, onboarding and workflow
                design, design systems, A/B testing
              </dd>
            </div>
            <div>
              <dt>Platform</dt>
              <dd>
                Turborepo, CI/CD (GitHub Actions, Jenkins, Spinnaker), codemods, CLI
                tooling, GraphQL federation, on-call
              </dd>
            </div>
            <div>
              <dt>AI</dt>
              <dd>agent-native workflows, MCP, AI-assisted development in daily work</dd>
            </div>
            <div>
              <dt>Leadership</dt>
              <dd>technical strategy, cross-team alignment, mentoring, hiring</dd>
            </div>
          </dl>
        </section>

        <section class="resume-section education" aria-labelledby="education-heading">
          <h2 id="education-heading">Education</h2>
          <article>
            <h3>Bachelor of Science, New Media</h3>
            <p>Rochester Institute of Technology</p>
          </article>
        </section>
      </article>
    </div>
  </div>
</BaseLayout>
